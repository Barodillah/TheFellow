<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Jangan redirect jika mengarah ke direktori API atau PDF
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteCond %{REQUEST_URI} !^/pdf/ [NC]
  
  # Jangan redirect jika file benar-benar ada
  RewriteCond %{REQUEST_FILENAME} !-f
  
  # Selain kondisi di atas, redirect semua request ke serve.php
  RewriteRule . /serve.php [L]
</IfModule>
